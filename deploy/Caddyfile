# Orion's public face: the Inkbox webhook (to the core) and the federation (to the guardian).
# Nothing else is reachable from outside.
@DOMAIN@ {
	encode gzip

	handle /inkbox/webhook {
		reverse_proxy 127.0.0.1:8787
	}
	handle /.well-known/agent-card.json {
		reverse_proxy 127.0.0.1:8788
	}
	handle /a2a {
		reverse_proxy 127.0.0.1:8788
	}
	handle {
		respond 404
	}
}
