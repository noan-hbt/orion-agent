# Secrets of the guardian process (mode 0600, owned by orion-guardian). The core never sees them.
INKBOX_API_KEY=
INKBOX_SIGNING_KEY=
# `orion federation keygen`
ORION_FEDERATION_KEY=
# Calendars, mail, web search… one variable per secret named in orion.toml, e.g.:
# CALENDAR_PERSO_URL=
# MAIL_GMAIL_PASSWORD=
# BRAVE_SEARCH_API_KEY=
