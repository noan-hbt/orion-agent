# Requis pour le fournisseur de modèles configuré par défaut.
OPENROUTER_API_KEY=

# Tools / services optionnels.
TAVILY_API_KEY=
GITHUB_TOKEN=

# Channels optionnels. N'ajoutez que les secrets des channels activés dans
# orion.toml.
TELEGRAM_BOT_TOKEN=
# Généré automatiquement par orion-install pour une nouvelle config Telegram.
# Gardez-le secret ; envoyez `/pair <secret>` une seule fois en privé au bot.
TELEGRAM_PAIRING_SECRET=
DISCORD_WEBHOOK_URL=
EMAIL_PASSWORD=
ORION_WEBHOOK_TOKEN=
ORION_WEBHOOK_REPLY_URL=

# Gateway HTTP top-level, uniquement si [gateway].enabled = true.
# Utilisez la variable correspondant à gateway.auth_mode.
ORION_GATEWAY_TOKEN=
ORION_GATEWAY_HMAC_SECRET=

# Observabilité / terminal optionnels.
ORION_LOG_JSON=0
ORION_ASCII=0
ORION_SCREEN_READER=0
# NO_COLOR=1
