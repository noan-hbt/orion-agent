# Fournisseur de modèles
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna #z-ai/glm-5.3-flash
OPENROUTER_STRONG_MODEL=openai/gpt-5.6-sol
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost
OPENROUTER_APP_TITLE=Orion
OPENROUTER_MAX_TOKENS=8192

# Recherche web optionnelle (Tavily : 1 000 crédits gratuits/mois)
TAVILY_API_KEY=

# Identité et runtime
ORION_OWNER_ID=
ORION_STATE_PATH=data/orion_state.json
ORION_VECTOR_MEMORY=auto
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBEDDING_DIMENSIONS=1536
ORION_MAX_RUNS=12
ORION_MAX_TOOL_CALLS=20
ORION_MAX_TASK_DURATION=1800
ORION_MAX_COST=5
ORION_MAX_DELEGATION_DEPTH=3

# Canaux optionnels
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
WEB_UI_PORT=5000
